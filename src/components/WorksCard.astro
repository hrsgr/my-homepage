---
interface Props {
    name: string;
    description: string;
    url: string;
    icon?: string;
}

const {
    name,
    description,
    url,
    icon = ""
} = Astro.props;
import "../../styles/style.css"
---

<a
    class="link-card"
    href={url}
    target="_blank"
    rel="noopener noreferrer"
>
    <div class="icon">
        {icon && (
            <img src={icon} alt="" />
        )}
    </div>

    <div class="text">
        <h3>{name}</h3>
        <p>{description}</p>
    </div>

    <span class="arrow">→</span>

</a>

<style>
    .link-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        margin: 10px;
        border-radius: 5px;
        border: 1px solid var(--gray_white);
        text-decoration: none;
        color: var(--pink-light);
        transition: ease;
    }

    .link-card:hover {
        transform: translateY(-3px);
        border-color: var(--blue);
    }

    .icon {
        width: 50%;
        aspect-ratio: 1 / 1;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        background-color: var(--pink-light);
        border-radius: 50%;
        overflow: hidden;
    }

    .icon img{
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .text {
        flex: 1;
    }

    .text h3 {
        margin: 0;
        font-size: 1.2rem;
    }

    .text p {
        margin: 3px 0 0;
        color: var(--text-light);
        font-size: 0.8rem;
    }
    @media screen and (max-width:590px) {
        .text h3 {
            font-size: 0.8rem;
        }

        .text p {
            font-size: 0.7rem;
        }
    }

    .arrow {
        color: var(--gray_white);
    }
</style>