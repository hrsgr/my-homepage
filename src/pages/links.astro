---
import Layout from "../layouts/Layout.astro";
import LinkCard from "../components/LinkCard.astro";
---

<Layout title="links | いとのホームページ">
	<h1>友達のサイト</h1>
	<div class="friend-links">
		<LinkCard
		name="みりん星"
		description="ポテトを愛しポテトに愛された人！楽器も絵も描けてすごい"
		url="https://mirin-homepage.vercel.app/"
		icon="https://unavatar.io/x/Mirin_2468"
		/>
        <LinkCard
        name="トラマト"
        description="ホームページ作成の解説を書いた人！尊敬してます！！"
        url="https://toramutton.me/"
        icon="https://unavatar.io/x/ToraMutton"
        />
	</div>
</Layout>

<style>
    
	.friend-links {
        display: grid;
        gap: 15px; 
    }
	.links {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap:15px;
    }
</style>