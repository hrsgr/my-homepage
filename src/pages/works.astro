---
import Layout from '../layouts/Layout.astro';
import WorksCard from '../components/WorksCard.astro';
---

<Layout title="Works | しぐれのホームページ">
	<h1>制作物</h1>
    <WorksCard
    name="ホームページ"
    description="このページです。Astroで作りました"
    url="https://github.com/hrsgr/my-homepage"
    icon="./images/sakaban.png"
    />
    <WorksCard
    name="ポモドーロタイマー"
    description="ポモドーロ法を自動で行うための勉強用タイマーです。GUIはまだありません。"
    url="https://github.com/hrsgr/pomodoro"
    icon="./images/pomodoro.png"
    />
    <WorksCard
    name="todoリスト"
    description="pythonのGUI勉強のために作ったTodoリストです。"
    url="https://github.com/hrsgr/todolist"
    icon="./images/todolist.png"
    />
    <WorksCard
    name="テトリス"
    description="C++で作ったコンソールで動作する簡単なテトリスです。"
    url="https://github.com/hrsgr/tetris"
    icon="./images/tetoris.png"
    />
</Layout>

<style>
    .works{
        border-radius: 15px;
        display: flex;
        flex-direction: row;
        gap: 0.5rem;
        background-color:rgb(174, 203, 233);
        margin: 10px;
        padding: 15px;
        border: radius 10px;
    }
    .contents{
        
    }
</style>